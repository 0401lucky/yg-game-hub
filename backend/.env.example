# 服务端口（Nginx 反代时保持内网端口即可）
PORT=3001

# 会话签名密钥。留空则自动生成并保存到 backend/data/session-secret.txt
# 换了密钥等于所有已登录用户被登出
# SESSION_SECRET=换成你自己的随机串

# 上了 HTTPS 后设为 1，会话 Cookie 才会带 Secure 标记
# COOKIE_SECURE=1

# 运营面板的独立管理密钥，与玩家账号和 SESSION_SECRET 无关。
# 未配置时入口关闭；配置或更换后重启服务生效，管理会话有效期为 8 小时。
# 建议使用至少 32 字符的随机串。不要提交实际密钥。
# ADMIN_KEY=换成你自己的管理密钥

# 单回合托管超时（毫秒），默认 20000
# THINKING_TIME_MS=20000
